{
  "name": "@schmiedmayerlab/grove-firebase-fhir",
  "version": "0.0.0",
  "description": "FHIR schemas and Firebase utilities for Grove applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:ci": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build",
    "version": "node ../../scripts/sync-workspace-versions.mjs"
  },
  "keywords": [
    "grove",
    "firebase",
    "fhir"
  ],
  "author": "Schmiedmayer Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchmiedmayerLab/grove-ts.git",
    "directory": "packages/firebase-fhir"
  },
  "bugs": {
    "url": "https://github.com/SchmiedmayerLab/grove-ts/issues"
  },
  "homepage": "https://github.com/SchmiedmayerLab/grove-ts#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@types/fhir": "^0.0.44",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@schmiedmayerlab/grove-configurations": "0.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "expect-type": "^1.3.0",
    "jest": "^30.4.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
