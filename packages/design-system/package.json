  "scripts": {
    "build": "tsc && vite build",
    "build-storybook": "storybook build",
    "clean": "rimraf dist storybook-static tsconfig.tsbuildinfo",
    "dev": "vite",
    "lint": "oxlint",
    "lint:types": "eslint .",
    "lint:ci": "oxlint --deny-warnings && eslint --max-warnings 0 .",
    "lint:fix": "oxlint --fix && eslint --fix .",
    "lint:package": "publint --strict --pack pnpm && attw --pack . --profile esm-only --exclude-entrypoints ./tailwind.css ./base.css --ignore-rules internal-resolution-error --quiet",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
