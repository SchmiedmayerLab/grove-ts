{
  "extends": "@schmiedmayerlab/grove-configurations/tsconfig/react-library",
  "compilerOptions": {
    "declarationMap": true,
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "docs", "storybook-static"]
}
