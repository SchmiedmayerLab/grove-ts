{
  "extends": "@schmiedmayerlab/grove-configurations/tsconfig/node-library",
  "compilerOptions": {
    // MessageType is a public enum, and replacing it would change the API.
    "erasableSyntaxOnly": false,
    "rootDir": "src",
    "outDir": "dist",
    "resolveJsonModule": true,
    "paths": {
      "@schmiedmayerlab/grove-firebase-utils": ["../firebase-utils/src"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
