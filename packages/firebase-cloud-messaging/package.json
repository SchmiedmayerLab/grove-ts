{
  "name": "@schmiedmayerlab/grove-firebase-cloud-messaging",
  "version": "0.0.0",
  "description": "Firebase Cloud Messaging utilities for Grove applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:ci": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "grove",
    "firebase",
    "fcm",
    "notifications",
    "push",
    "messaging"
  ],
  "author": "Schmiedmayer Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchmiedmayerLab/grove-ts.git",
    "directory": "packages/firebase-cloud-messaging"
  },
  "bugs": {
    "url": "https://github.com/SchmiedmayerLab/grove-ts/issues"
  },
  "homepage": "https://github.com/SchmiedmayerLab/grove-ts#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@schmiedmayerlab/grove-firebase-utils": "0.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@schmiedmayerlab/grove-configurations": "0.0.0",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "firebase-admin": "^14.2.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "firebase-admin": "^14.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
