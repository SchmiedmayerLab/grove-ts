{
  "name": "@schmiedmayerlab/grove-firebase-cloud-messaging",
  "version": "0.0.0",
  "description": "Firebase Cloud Messaging utilities for Grove applications",
  "keywords": [
    "fcm",
    "firebase",
    "grove",
    "messaging",
    "notifications",
    "push"
  ],
  "homepage": "https://github.com/SchmiedmayerLab/grove-ts#readme",
  "bugs": {
    "url": "https://github.com/SchmiedmayerLab/grove-ts/issues"
  },
  "license": "MIT",
  "author": "Schmiedmayer Lab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchmiedmayerLab/grove-ts.git",
    "directory": "packages/firebase-cloud-messaging"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:types": "eslint .",
    "lint:ci": "oxlint --deny-warnings && eslint --max-warnings 0 .",
    "lint:fix": "oxlint --fix && eslint --fix .",
    "lint:package": "publint --strict --pack pnpm && attw --pack . --profile esm-only",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@schmiedmayerlab/grove-firebase-utils": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@schmiedmayerlab/grove-configurations": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "firebase-admin": "^14.5.1",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "firebase-admin": "^14.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
