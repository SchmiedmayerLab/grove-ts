{
  "name": "@schmiedmayerlab/grove-configurations",
  "version": "0.0.0",
  "description": "Shared ESLint and Prettier configurations for Grove TypeScript projects",
  "author": "Schmiedmayer Lab",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "grove",
    "typescript",
    "configuration",
    "eslint",
    "prettier",
    "linting",
    "formatting"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchmiedmayerLab/grove-ts.git",
    "directory": "packages/configurations"
  },
  "bugs": {
    "url": "https://github.com/SchmiedmayerLab/grove-ts/issues"
  },
  "homepage": "https://github.com/SchmiedmayerLab/grove-ts#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "source": "src/index.ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "parcel build",
    "clean": "rimraf dist .parcel-cache",
    "dev": "parcel watch",
    "lint": "eslint .",
    "lint:ci": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "version": "node ../../scripts/sync-workspace-versions.mjs"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/utils": "^8.65.0",
    "eslint-config-prettier": "^10",
    "eslint-plugin-import": "^2",
    "eslint-plugin-prefer-arrow-functions": "^3.9.1",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "prettier": "^3"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@parcel/packager-ts": "^2.16.4",
    "@parcel/transformer-typescript-types": "^2.16.4",
    "@types/node": "^24.10.0",
    "parcel": "^2.16.4",
    "rimraf": "^6.1.2",
    "typescript": "^6.0.3"
  }
}
