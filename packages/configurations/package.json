{
  "name": "@schmiedmayerlab/grove-configurations",
  "version": "0.0.0",
  "description": "Shared ESLint and Prettier configurations for Grove TypeScript projects",
  "author": "Schmiedmayer Lab",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "grove",
    "typescript",
    "configuration",
    "eslint",
    "prettier",
    "linting",
    "formatting"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchmiedmayerLab/grove-ts.git",
    "directory": "packages/configurations"
  },
  "bugs": {
    "url": "https://github.com/SchmiedmayerLab/grove-ts/issues"
  },
  "homepage": "https://github.com/SchmiedmayerLab/grove-ts#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "source": "src/index.ts",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --out-dir dist",
    "clean": "rimraf dist",
    "dev": "tsdown src/index.ts --format esm --dts --watch --out-dir dist",
    "lint": "eslint .",
    "lint:ci": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "version": "node ../../scripts/sync-workspace-versions.mjs"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.18.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/utils": "^8.65.0",
    "eslint-config-prettier": "^10",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prefer-arrow-functions": "^3.9.1",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "eslint": "^10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "prettier": "^3"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "rimraf": "^6.1.2",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
