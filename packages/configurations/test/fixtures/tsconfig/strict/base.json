// Stands in for a framework base such as astro/tsconfigs/strict.
{
  "compilerOptions": {
    "strict": false,
    "target": "es2023",
    "lib": ["es2023"],
    "module": "preserve",
    "jsx": "preserve",
    "noEmit": true,
    "types": []
  }
}
