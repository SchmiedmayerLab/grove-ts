{
  "extends": "./tsconfig/node-app.json",
  "compilerOptions": {
    // tsdown bundles the sources, so relative imports need no extensions.
    "module": "preserve",
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "incremental": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "test/fixtures"]
}
