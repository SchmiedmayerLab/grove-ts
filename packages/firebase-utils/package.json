{
  "name": "@schmiedmayerlab/grove-firebase-utils",
  "version": "0.0.0",
  "description": "Utility functions for Firebase projects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:ci": "eslint --output-file eslint_report.json --format json .",
    "lint:fix": "eslint . --fix",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build",
    "version": "node ../../scripts/sync-workspace-versions.mjs"
  },
  "author": "Schmiedmayer Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchmiedmayerLab/grove-ts.git",
    "directory": "packages/firebase-utils"
  },
  "bugs": {
    "url": "https://github.com/SchmiedmayerLab/grove-ts/issues"
  },
  "homepage": "https://github.com/SchmiedmayerLab/grove-ts#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "firebase",
    "firestore",
    "utilities",
    "helpers",
    "zod",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@schmiedmayerlab/grove-configurations": "0.0.0",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
