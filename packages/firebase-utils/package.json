{
  "name": "@schmiedmayerlab/grove-firebase-utils",
  "version": "0.0.0",
  "description": "Utility functions for Firebase projects",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src --resolve-plugins-relative-to .",
    "lint:fix": "eslint src --fix --resolve-plugins-relative-to .",
    "build": "tsc --noEmitOnError false || true",
    "watch": "tsc --watch",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "author": "Schmiedmayer Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SchmiedmayerLab/grove-ts.git",
    "directory": "packages/firebase-utils"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "firebase",
    "firestore",
    "utilities",
    "helpers",
    "zod",
    "typescript"
  ],
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^8.57",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jsdoc": "^61.2.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.6.2",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6"
  }
}
