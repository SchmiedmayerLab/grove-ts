  "statusDefinitions": {
    "supported": "The named adapter emits and validates this exact Mobile profile in version 0.2.0.",
    "mapped-standard": "Related source data is admitted only in the coverageDetails alternate representation. It does not implement or claim this Mobile profile.",
    "provider-specific": "The source meaning is admitted only by an adapter/provider-specific profile and does not implement this Mobile profile.",
    "deferred": "The source has related data, but version 0.2.0 admits no output for this Mobile meaning.",
    "intentionally-unsupported": "The source has no semantically exact mapping to this Mobile meaning in the closed version 0.2.0 contract."
  },
  "effectiveCanonicalization": {
    "scope": "Every Mobile scalar or aggregate effectiveDateTime and effectivePeriod endpoint; Sensor and ECG SampledData timing is excluded.",
