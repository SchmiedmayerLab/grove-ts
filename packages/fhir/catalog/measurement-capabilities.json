{
  "schemaVersion": 1,
  "igVersion": "0.2.0",
  "canonicalBase": "https://grovealliance.org/fhir",
  "recordConversion": {
    "input": "One connected-provider source record with a non-empty unique subset of the catalog-admitted outputs actually present.",
    "atomicity": "Every present output is validated before construction; any failure rejects the whole conversion without a partial graph.",
    "provenance": "Exactly one conversion Provenance targets every output emitted for the source record.",
    "ordering": "Catalog order is used only for deterministic serialization and has no FHIR semantic meaning.",
    "fetchBoundary": "Provider clients, authentication, pagination, webhooks, and raw response models remain outside grove-fhir."
  },
  "statuses": {
    "implemented": "A closed public builder emits resources conforming to the listed v0.2 profile.",
    "implemented-recording": "The closed native-recording builder emits the exact Sensor + Provider DocumentReference graph for this catalogued provider source token.",
    "profiled-not-admitted": "The shared profile exists, but this adapter facade has no supported provider source.",
    "adapter-profiled": "Version 0.2 defines an adapter-owned or standard-plus-adapter profile claim; it is intentionally not a shared Mobile profile and is outside this Provider facade.",
    "planned-shared": "The concept is shared by multiple sources but has no admitted v0.2 Grove builder.",
    "adapter-specific": "The semantics are source-specific and must not be collapsed into a shared concept.",
    "sensor-ig": "The concept belongs to the Sensor and Waveform contract.",
    "not-in-scope": "The source exposes the record, but it is not a mobile measurement admitted by this package."
  },
