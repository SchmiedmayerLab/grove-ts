{
  "schemaVersion": 0,
  "version": "0.6.0",
  "bases": [
    {"id": "source-event", "path": "source-event.json"},
    {"id": "export-a", "path": "export-a.json"}
  ],
  "cases": [
    {
      "id": "subject-mismatch",
      "base": "source-event",
      "patch": [{"op": "replace", "path": "/entry/7/resource/individual", "value": {"type": "Patient", "identifier": {"system": "https://study.example.org/fhir/identifiers/participant", "value": "participant-002"}}}],
      "expectedRule": {"code": "receiver-study.subject-mismatch", "reason": "Study enrollment subject differs from the verified source subject."}
    },
    {
      "id": "protocol-is-not-a-reference",
      "base": "source-event",
      "patch": [{"op": "replace", "path": "/entry/6/resource/protocol/0", "value": "https://study.example.org/PlanDefinition/a|1"}],
      "expectedRule": {"code": "mobile-exchange.reference-shape", "reason": "ResearchStudy.protocol requires a Reference, not a canonical string."}
    },
    {
      "id": "lost-historical-revision",
      "base": "export-a",
      "patch": [{"op": "replace", "path": "/entry/4/resource/version", "value": "2"}],
      "expectedRule": {"code": "receiver-study.historical-revision", "reason": "The export's protocol differs from the immutable revision authorized by its grant."}
    },
    {
      "id": "derived-export-as-event-retry",
      "base": "export-a",
      "patch": [{"op": "replace", "path": "/identifier", "value": {"type": {"coding": [{"code": "event", "system": "https://grovealliance.org/fhir/mobile/CodeSystem/grove-identifier-role", "display": "Event"}]}, "system": "https://study.example.org/fhir/NamingSystem/grove-event-v0", "value": "e0:1f5c58aa-6ec6-4e79-a682-829a9debd3f5:50"}}],
      "expectedRule": {"code": "receiver-study.not-exact-replay", "reason": "A filtered export cannot reuse the immutable producer event identity for different bytes."}
    }
  ]
}
