{
  "name": "@schmiedmayerlab/grove-fhir",
  "version": "0.0.0",
  "description": "Strict FHIR R4 contracts and Grove resource builders for TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./r4": {
      "types": "./dist/r4/index.d.ts",
      "default": "./dist/r4/index.js"
    },
    "./mobile": {
      "types": "./dist/mobile/index.d.ts",
      "default": "./dist/mobile/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    },
    "./questionnaire": {
      "types": "./dist/questionnaire/index.d.ts",
      "default": "./dist/questionnaire/index.js"
    },
    "./zod/r4": {
      "types": "./dist/zod/r4/index.d.ts",
      "default": "./dist/zod/r4/index.js"
    },
    "./zod/r4b": {
      "types": "./dist/zod/r4b/index.d.ts",
      "default": "./dist/zod/r4b/index.js"
    }
  },
  "scripts": {
    "fetch:grove-fhir": "node scripts/fetch-grove-fhir.mjs",
    "generate:catalog": "npm run fetch:grove-fhir && node scripts/generate-measurement-catalog.mjs",
    "check:catalog": "npm run fetch:grove-fhir && node scripts/generate-measurement-catalog.mjs --check",
    "generate:fixtures": "npm run fetch:grove-fhir && npm run build && node scripts/generate-conformance-fixtures.mjs",
    "check:fixtures": "npm run fetch:grove-fhir && npm run build && node scripts/generate-conformance-fixtures.mjs --check",
    "conformance": "npm run fetch:grove-fhir && npm run build && node scripts/validate-conformance.mjs",
    "conformance:structural": "npm run fetch:grove-fhir && npm run build && node scripts/validate-conformance.mjs --structural-only",
    "lint": "eslint .",
    "lint:ci": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "npm run test:unit && npm run test:package",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "typecheck": "npm run check:catalog && npm run check:zod && tsc --noEmit && tsc -p test/tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build",
    "generate:zod": "node scripts/generate-zod-schemas.mjs --release r4 && node scripts/generate-zod-schemas.mjs --release r4b",
    "check:zod": "node scripts/generate-zod-schemas.mjs --release r4 --check && node scripts/generate-zod-schemas.mjs --release r4b --check"
  },
  "keywords": [
    "grove",
    "fhir",
    "fhir-r4",
    "health-data"
  ],
  "author": "Schmiedmayer Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchmiedmayerLab/grove-ts.git",
    "directory": "packages/fhir"
  },
  "bugs": {
    "url": "https://github.com/SchmiedmayerLab/grove-ts/issues"
  },
  "homepage": "https://github.com/SchmiedmayerLab/grove-ts#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "catalog",
    "fixtures/conformance",
    "fixtures/normalized",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "@types/fhir": "^0.0.44",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@schmiedmayerlab/grove-configurations": "0.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "expect-type": "^1.3.0",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
