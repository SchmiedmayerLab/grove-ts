{
  "name": "@schmiedmayerlab/grove-fhir",
  "version": "0.0.0",
  "description": "FHIR schemas for Grove applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./r4": {
      "types": "./dist/r4/index.d.ts",
      "default": "./dist/r4/index.js"
    },
    "./mobile": {
      "types": "./dist/mobile/index.d.ts",
      "default": "./dist/mobile/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    },
    "./questionnaire": {
      "types": "./dist/questionnaire/index.d.ts",
      "default": "./dist/questionnaire/index.js"
    },
    "./provenance": {
      "types": "./dist/provenance/index.d.ts",
      "default": "./dist/provenance/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:ci": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist .tsbuild tsconfig.tsbuildinfo",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:baseline": "npm run build && node scripts/compare-against-baseline.mjs",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "fetch:grove-fhir": "node scripts/fetch-grove-fhir.mjs",
    "generate:catalog": "npm run fetch:grove-fhir && node scripts/generate-measurement-catalog.mjs",
    "check:catalog": "npm run fetch:grove-fhir && node scripts/generate-measurement-catalog.mjs --check",
    "generate:fixtures": "npm run fetch:grove-fhir && npm run build && node scripts/generate-conformance-fixtures.mjs",
    "check:fixtures": "npm run fetch:grove-fhir && npm run build && node scripts/generate-conformance-fixtures.mjs --check",
    "conformance": "npm run fetch:grove-fhir && npm run build && node scripts/validate-conformance.mjs",
    "conformance:structural": "npm run fetch:grove-fhir && npm run build && node scripts/validate-conformance.mjs --structural-only",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json && npm run typecheck:strict",
    "typecheck:strict": "tsc -b tsconfig.strict.json",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "grove",
    "fhir"
  ],
  "author": "Schmiedmayer Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchmiedmayerLab/grove-ts.git",
    "directory": "packages/fhir"
  },
  "bugs": {
    "url": "https://github.com/SchmiedmayerLab/grove-ts/issues"
  },
  "homepage": "https://github.com/SchmiedmayerLab/grove-ts#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "fixtures/normalized",
    "catalog",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "@types/fhir": "^0.0.44",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@schmiedmayerlab/grove-configurations": "0.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "expect-type": "^1.3.0",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
