{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "isolatedModules": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@schmiedmayerlab/grove-firebase-utils": ["../firebase-utils/src"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
