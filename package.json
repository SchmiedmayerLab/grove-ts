{
  "name": "@schmiedmayerlab/grove",
  "version": "0.0.0",
  "private": true,
  "author": "Schmiedmayer Lab",
  "license": "MIT",
  "description": "TypeScript packages for the Grove ecosystem",
  "keywords": [
    "grove",
    "typescript",
    "react",
    "firebase",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchmiedmayerLab/grove-ts.git"
  },
  "bugs": {
    "url": "https://github.com/SchmiedmayerLab/grove-ts/issues"
  },
  "homepage": "https://github.com/SchmiedmayerLab/grove-ts#readme",
  "engines": {
    "node": ">=24",
    "npm": ">=12"
  },
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/configurations",
    "packages/design-system",
    "packages/firebase-utils",
    "packages/firebase-fhir",
    "packages/firebase-cloud-messaging"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:fhir": "npm run build -w @schmiedmayerlab/grove-firebase-fhir",
    "build:utils": "npm run build -w @schmiedmayerlab/grove-firebase-utils",
    "build:cloud-messaging": "npm run build -w @schmiedmayerlab/grove-firebase-cloud-messaging",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "npm run build --workspace @schmiedmayerlab/grove-configurations",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "lint:ci": "npm run lint:ci --workspaces --if-present",
    "lint:strict": "npm run lint:ci",
    "analyze": "knip --include files,dependencies,unlisted,exports --no-config-hints && knip --cycles --workspace '!packages/firebase-fhir' --no-config-hints",
    "pretest": "npm run build",
    "test": "npm run test:release && npm run test --workspaces --if-present",
    "test:release": "node --test scripts/release-plan.test.mjs",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:fhir": "npm run test -w @schmiedmayerlab/grove-firebase-fhir",
    "test:utils": "npm run test -w @schmiedmayerlab/grove-firebase-utils",
    "test:cloud-messaging": "npm run test -w @schmiedmayerlab/grove-firebase-cloud-messaging",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pack:check": "node scripts/verify-packages.mjs",
    "pack:lint": "node scripts/lint-packages.mjs",
    "audit": "npm audit --audit-level=low",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "audit:docs": "npm audit --prefix packages/design-system/docs --audit-level=low",
    "audit:signatures": "npm audit signatures",
    "validate": "npm run format:check && npm run lint:ci && npm run analyze && npm run typecheck && npm test && npm run docs:ci && npm run pack:check && npm run pack:lint && npm run audit && npm run audit:docs",
    "docs": "npm run dev --prefix packages/design-system/docs",
    "docs:ci": "npm run build --prefix packages/design-system/docs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@storybook/react-vite": "^10.5.5",
    "knip": "^6.31.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.22"
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.15.47": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "lmdb@2.8.5": true,
    "msgpackr-extract@3.0.4": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  },
  "knip": {
    "workspaces": {
      ".": {
        "entry": [
          "scripts/*.mjs"
        ],
        "project": [
          "scripts/**/*.mjs"
        ],
        "ignoreDependencies": [
          "@arethetypeswrong/cli",
          "@storybook/react-vite",
          "publint"
        ]
      },
      "packages/configurations": {
        "entry": [
          "src/index.ts"
        ],
        "project": [
          "src/**/*.ts"
        ],
        "ignoreDependencies": [
          "prettier-plugin-tailwindcss"
        ]
      },
      "packages/design-system": {
        "entry": [
          "src/index.ts",
          "src/**/index.{ts,tsx}",
          ".storybook/*.{ts,tsx}"
        ],
        "project": [
          "src/**/*.{ts,tsx,css,mdx}",
          ".storybook/*.{ts,tsx}",
          "*.{ts,tsx}"
        ],
        "ignoreDependencies": [
          "tailwindcss",
          "tw-animate-css"
        ]
      },
      "packages/firebase-utils": {
        "project": [
          "src/**/*.ts",
          "test/**/*.ts"
        ]
      },
      "packages/firebase-fhir": {
        "project": [
          "src/**/*.ts",
          "test/**/*.ts"
        ]
      },
      "packages/firebase-cloud-messaging": {
        "project": [
          "src/**/*.ts",
          "test/**/*.ts"
        ]
      }
    }
  }
}
