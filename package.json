{
  "name": "@schmiedmayerlab/grove",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript packages for the Grove ecosystem",
  "keywords": [
    "design-system",
    "firebase",
    "grove",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/SchmiedmayerLab/grove-ts#readme",
  "bugs": {
    "url": "https://github.com/SchmiedmayerLab/grove-ts/issues"
  },
  "license": "MIT",
  "author": "Schmiedmayer Lab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchmiedmayerLab/grove-ts.git"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "build:fhir": "pnpm --filter @schmiedmayerlab/grove-fhir run build",
    "build:utils": "pnpm --filter @schmiedmayerlab/grove-firebase-utils run build",
    "build:cloud-messaging": "pnpm --filter @schmiedmayerlab/grove-firebase-cloud-messaging run build",
    "clean": "pnpm -r --filter \"./packages/*\" run clean",
    "configure:trusted-publishing": "node scripts/configure-trusted-publishing.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prelint": "pnpm --filter @schmiedmayerlab/grove-configurations run build",
    "lint": "pnpm -r --filter \"./packages/*\" run lint",
    "lint:types": "pnpm -r --filter \"./packages/*\" run lint:types",
    "lint:fix": "pnpm -r --filter \"./packages/*\" run lint:fix",
    "lint:ci": "pnpm -r --filter \"./packages/*\" run lint:ci",
    "lint:strict": "pnpm run lint:ci",
    "analyze": "knip --include files,dependencies,unlisted,exports --no-config-hints && knip --cycles --workspace '!packages/fhir' --no-config-hints",
    "pretest": "pnpm run build",
    "test": "pnpm run test:release && pnpm -r --filter \"./packages/*\" run test",
    "test:release": "node --test scripts/*.test.mjs",
    "test:coverage": "pnpm -r --filter \"./packages/*\" run test:coverage",
    "test:fhir": "pnpm --filter @schmiedmayerlab/grove-fhir run test",
    "test:utils": "pnpm --filter @schmiedmayerlab/grove-firebase-utils run test",
    "test:cloud-messaging": "pnpm --filter @schmiedmayerlab/grove-firebase-cloud-messaging run test",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "pack:check": "node scripts/verify-packages.mjs",
    "pack:lint": "pnpm -r --filter \"./packages/*\" run lint:package",
    "audit": "node scripts/audit-dependencies.mjs root",
    "audit:production": "node scripts/audit-dependencies.mjs production",
    "audit:signatures": "pnpm audit signatures",
    "validate": "pnpm run build && pnpm run format:check && pnpm run lint:ci && pnpm run analyze && pnpm run typecheck && pnpm test && pnpm run docs:ci && pnpm run pack:check && pnpm run pack:lint && pnpm run audit",
    "predocs": "pnpm --filter @schmiedmayerlab/grove-configurations run build",
    "docs": "pnpm --filter @schmiedmayerlab/grove-docs run dev",
    "predocs:ci": "pnpm --filter @schmiedmayerlab/grove-configurations run build",
    "docs:ci": "pnpm --filter @schmiedmayerlab/grove-docs run build",
    "pages:build": "pnpm run showcase && pnpm run docs:ci && node scripts/prepare-pages.mjs",
    "showcase": "pnpm --filter @schmiedmayerlab/grove-design-system run build-storybook && pnpm run showcase:generate",
    "showcase:generate": "node scripts/generate-showcase.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@storybook/react-vite": "^10.5.5",
    "knip": "^6.29.0",
    "oxfmt": "^0.78.0",
    "playwright": "^1.62.1",
    "publint": "^0.3.22"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.20.0",
  "knip": {
    "ignoreWorkspaces": [
      "packages/design-system/docs"
    ],
    "workspaces": {
      ".": {
        "entry": [
          "scripts/*.mjs"
        ],
        "project": [
          "scripts/**/*.mjs"
        ],
        "ignoreDependencies": [
          "@arethetypeswrong/cli",
          "@storybook/react-vite",
          "publint"
        ]
      },
      "packages/configurations": {
        "entry": [
          "src/index.ts",
          "src/eslint/typeAware.ts",
          "src/oxlint/index.ts",
          "src/oxlint/sonarjs.ts",
          "src/oxfmt.ts",
          "src/prettier.ts",
          "test/*.test.ts"
        ],
        "project": [
          "src/**/*.ts"
        ],
        "ignoreDependencies": [
          "@types/react",
          "prettier-plugin-tailwindcss"
        ],
        "ignore": [
          "test/fixtures/**"
        ]
      },
      "packages/design-system": {
        "entry": [
          "src/index.ts",
          "src/**/index.{ts,tsx}",
          ".storybook/*.{ts,tsx}"
        ],
        "project": [
          "src/**/*.{ts,tsx,css,mdx}",
          ".storybook/*.{ts,tsx}",
          "*.{ts,tsx}"
        ],
        "ignoreDependencies": [
          "tailwindcss",
          "tw-animate-css"
        ]
      },
      "packages/firebase-utils": {
        "project": [
          "src/**/*.ts",
          "test/**/*.ts"
        ]
      },
      "packages/fhir": {
        "project": [
          "src/**/*.ts",
          "test/**/*.ts"
        ]
      },
      "packages/firebase-cloud-messaging": {
        "project": [
          "src/**/*.ts",
          "test/**/*.ts"
        ]
      }
    }
  }
}
